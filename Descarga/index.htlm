<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sonomix Radio</title>

<style>
body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: linear-gradient(135deg, #f4f6f9, #e9edf3);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    min-height: 100vh;
}

.container {
    text-align: center;
    margin-top: 60px;
    background: #ffffff;
    padding: 40px 30px;
    border-radius: 25px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
    width: 90%;
    max-width: 420px;
}

.logo {
    width: 230px;
    height: 230px;
    object-fit: contain;
    margin-bottom: 20px;
}

h1 {
    margin: 10px 0 35px;
    font-size: 32px;
    color: #000000;
}

.download-btn {
    display: inline-block;
    padding: 22px 60px;
    background: linear-gradient(90deg, #1e73e8, #0057d9);
    color: #fff;
    font-size: 20px;
    font-weight: bold;
    border-radius: 50px;
    text-decoration: none;
    transition: 0.3s ease;
    box-shadow: 0 8px 25px rgba(0,87,217,0.4);
}

.download-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 30px rgba(0,87,217,0.6);
}

.small-text {
    margin-top: 15px;
    font-size: 14px;
    color: #777;
}

footer {
    text-align: center;
    padding: 20px;
    color: #555;
    font-size: 14px;
}
</style>

</head>
<body>

<div class="container">

    <img src="https://sonomixradio.github.io/logo-sonomix.png" alt="Sonimix Radio Logo" class="logo">

    <h1>Sonomix Radio</h1>

    <a href="https://apk.e-droid.net/apk/app3935238-ngmrwx.apk?v=1" class="download-btn" download>
        ⬇ Descargar
    </a>

    <div class="small-text">(Archivo APK)</div>

</div>

<footer>
    <div>© 2026 Sonomix Radio</div>
    <div>Todos los derechos reservados.</div>
</footer>

</body>
</html>
